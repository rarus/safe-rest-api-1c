    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Справочниккв_ШаблоныСервисов.Ссылка КАК Ссылка,
	Справочниккв_ШаблоныСервисов.ПометкаУдаления КАК ПометкаУдаления,
	Справочниккв_ШаблоныСервисов.Владелец КАК Владелец,
	Справочниккв_ШаблоныСервисов.Код КАК Код,
	Справочниккв_ШаблоныСервисов.Наименование КАК Наименование,
	Справочниккв_ШаблоныСервисов.Предопределенный КАК Предопределенный,
	Справочниккв_ШаблоныСервисов.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	ВЫБОР
		КОГДА Справочниккв_ШаблоныСервисов.ПометкаУдаления
			ТОГДА 4
		КОГДА Справочниккв_ШаблоныСервисов.Предопределенный
			ТОГДА 5
		ИНАЧЕ 3
	КОНЕЦ КАК Картинка,
	ЕСТЬNULL(втМетодыШаблонов.HTTPМетод, ЗНАЧЕНИЕ(Перечисление.кв_HTTPМетоды.ПустаяСсылка)) КАК HTTPМетод,
	ЕСТЬNULL(втМетодыШаблонов.СпособЛогирования, ЗНАЧЕНИЕ(Перечисление.кв_СпособыЛогирования.ПустаяСсылка)) КАК СпособЛогирования,
	ЕСТЬNULL(втМетодыШаблонов.ОчищатьОтветВЛоге, ЛОЖЬ) КАК ОчищатьОтветВЛоге
ИЗ
	Справочник.кв_ШаблоныСервисов КАК Справочниккв_ШаблоныСервисов
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.кв_ШаблоныСервисов.Методы КАК втМетодыШаблонов
		ПО (втМетодыШаблонов.Ссылка = Справочниккв_ШаблоныСервисов.Ссылка)</queryText>
